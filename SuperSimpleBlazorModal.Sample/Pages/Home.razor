@page "/"
@using SuperSimpleBlazorModal

<PageTitle>SuperSimpleBlazorModal</PageTitle>

<div class="container py-4">
    <h1 class="h4 mb-4">SuperSimpleBlazorModal</h1>

    <h2 class="h6">Backdrop close</h2>
    <span class="badge @(isBackdropModalOpen ? "bg-success" : "bg-secondary")">@(isBackdropModalOpen ? "Open" : "Closed")</span>
    <button type="button" class="btn btn-primary btn-sm ms-2" @onclick="ShowBackdropModal">Show Modal</button>

    <h2 class="h6 mt-4">Explicit close</h2>
    <span class="badge @(isExplicitModalOpen ? "bg-success" : "bg-secondary")">@(isExplicitModalOpen ? "Open" : "Closed")</span>
    <button type="button" class="btn btn-primary btn-sm ms-2" @onclick="ShowExplicitModal">Show Modal</button>

    <h2 class="h6 mt-4">Parameter settings</h2>
    <table class="table table-sm table-bordered w-auto">
        <thead>
            <tr>
                <th>Parameter</th>
                <th>Demo 1 (backdrop close)</th>
                <th>Demo 2 (explicit close)</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td><code>ChildContent</code></td>
                <td>Custom markup with a close button</td>
                <td>Custom markup with a close button</td>
            </tr>
            <tr>
                <td><code>Id</code></td>
                <td><code>backdrop-close-modal</code></td>
                <td><code>explicit-close-modal</code></td>
            </tr>
            <tr>
                <td><code>ExtraCssClass</code></td>
                <td><code>modal-reset p-3</code></td>
                <td><code>modal-reset border</code></td>
            </tr>
            <tr>
                <td><code>OpenOnFirstRender</code></td>
                <td><code>true</code></td>
                <td><code>false</code></td>
            </tr>
            <tr>
                <td><code>OnModalStateChange</code></td>
                <td><code>BackdropModalStateChanged</code></td>
                <td><code>ExplicitModalStateChanged</code></td>
            </tr>
            <tr>
                <td><code>BackdropClose</code></td>
                <td><code>true</code></td>
                <td><code>false</code></td>
            </tr>
        </tbody>
    </table>
</div>

<SimpleModal
    @ref="BackdropModalRef"
    Id="backdrop-close-modal"
    ExtraCssClass="modal-reset p-3"
    OpenOnFirstRender="true"
    BackdropClose="true"
    OnModalStateChange="BackdropModalStateChanged">
    <p class="mb-3">This modal closes when the backdrop is clicked.</p>
    <button type="button" class="btn btn-primary" @onclick="CloseBackdropModal">Close</button>
</SimpleModal>

<SimpleModal
    @ref="ExplicitModalRef"
    Id="explicit-close-modal"
    ExtraCssClass="modal-reset border"
    OpenOnFirstRender="false"
    BackdropClose="false"
    OnModalStateChange="ExplicitModalStateChanged">
    <p class="mb-3">Clicking the backdrop does not close this modal.</p>
    <button type="button" class="btn btn-primary" @onclick="CloseExplicitModal">Close</button>
</SimpleModal>

@code {
    private bool isBackdropModalOpen = true;
    private bool isExplicitModalOpen = false;

    private SimpleModal? BackdropModalRef;
    private SimpleModal? ExplicitModalRef;

    private async Task ShowBackdropModal()
    {
        if (BackdropModalRef is not null)
        {
            await BackdropModalRef.ShowModal();
        }
    }

    private async Task ShowExplicitModal()
    {
        if (ExplicitModalRef is not null)
        {
            await ExplicitModalRef.ShowModal();
        }
    }

    private async Task CloseBackdropModal()
    {
        if (BackdropModalRef is not null)
        {
            await BackdropModalRef.CloseModal();
        }
    }

    private async Task CloseExplicitModal()
    {
        if (ExplicitModalRef is not null)
        {
            await ExplicitModalRef.CloseModal();
        }
    }

    private void BackdropModalStateChanged(bool isOpen)
    {
        isBackdropModalOpen = isOpen;
    }

    private void ExplicitModalStateChanged(bool isOpen)
    {
        isExplicitModalOpen = isOpen;
    }
}
