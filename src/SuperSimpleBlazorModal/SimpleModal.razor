@using Microsoft.JSInterop
@namespace SuperSimpleBlazorModal
@implements IAsyncDisposable
@inject IJSRuntime JS

<dialog @ref="DialogElement" id="@Id" class="@ExtraCssClass" closedby="@(BackdropClose ? "any" : null)">
    @ChildContent
</dialog>

@code {
    [Parameter]
    [EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string Id { get; set; } = Guid.NewGuid().ToString();

    [Parameter]
    public string ExtraCssClass { get; set; } = "";

    [Parameter]
    public bool OpenOnFirstRender { get; set; } = false;

    [Parameter]
    public EventCallback<bool> OnModalStateChange { get; set; }

    [Parameter]
    public bool BackdropClose { get; set; } = true;

    private ElementReference DialogElement;
    private IJSObjectReference? _jsModule;
    private bool _isOpen;

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // BL0016: JS interop can fail (e.g. circuit disconnect). If the module can't load,
            // _jsModule stays null and ShowModal/CloseModal no-op instead of crashing.
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/SuperSimpleBlazorModal/simpleModal.js");
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }

            if (OpenOnFirstRender)
            {
                await ShowModal();
            }
        }
    }

    public async Task ShowModal()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("showModal", DialogElement);
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
                return;
            }
            _isOpen = true;
            if (OnModalStateChange.HasDelegate)
            {
                await OnModalStateChange.InvokeAsync(_isOpen);
            }
        }
    }

    public async Task CloseModal()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("closeModal", DialogElement);
            }
            catch (JSDisconnectedException)
            {
                return;
            }
            catch (JSException)
            {
                return;
            }
            _isOpen = false;
            if (OnModalStateChange.HasDelegate)
            {
                await OnModalStateChange.InvokeAsync(_isOpen);
            }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (_jsModule is not null)
            {
                await _jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
